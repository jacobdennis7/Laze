# Build-time app credentials (safe to expose in a frontend when properly restricted):
# - Client ID is public by design; restrict by Authorized JavaScript origins in GCP.
# - Maps key must be restricted to your domains + the Routes API in GCP.
VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
VITE_MAPS_KEY=AIza...

# Set to 1 to bundle src/data/events.local.js (personal demo data) into the build.
# NEVER set this for a public deployment.
VITE_DEMO=0
